<svg viewBox="0 0 1400 1458" class="flow" role="img" aria-label="The guardrail pipeline, gate by gate">
<g class="node terminal" data-node="user-in">
  <rect x="420" y="54" width="440" height="74" rx="11"/>
  <text class="title" x="640" y="84">Someone asks a question</text>
  <text class="mono" x="640" y="106">signed in — a citizen sees less than an operator</text>
</g>
<path class="edge" d="M640 128 L640 167" marker-end="url(#arrow)"/>
<text class="edge-label" x="654" y="156">the question, and who is asking</text>
<g class="node gate" data-node="gate1">
  <rect x="340" y="176" width="600" height="88" rx="11"/>
  <text class="gate-label" x="360" y="202">GATE 1 — THE QUESTION</text>
  <text class="title left" x="360" y="227">Is the question allowed through?</text>
  <text class="mono left" x="360" y="249">clean up the text first, then seven checks at once</text>
</g>
<path class="deny" d="M940 220 L1268 220"/>
<text class="deny-label" x="956" y="210">REFUSED — the model is never called</text>
<path class="edge" d="M640 264 L640 284"/>
<path class="edge" d="M130 284 L1150 284"/>
<path class="edge" d="M130 284 L130 301" marker-end="url(#arrow)"/>
<g class="node solid">
  <rect x="51" y="310" width="158" height="66" rx="10"/>
  <text class="title small" x="130" y="339">Banned words</text>
  <text class="mono" x="130" y="360">words</text>
</g>
<path class="edge" d="M300 284 L300 301" marker-end="url(#arrow)"/>
<g class="node solid">
  <rect x="221" y="310" width="158" height="66" rx="10"/>
  <text class="title small" x="300" y="339">Personal details</text>
  <text class="mono" x="300" y="360">pii</text>
</g>
<path class="edge" d="M470 284 L470 301" marker-end="url(#arrow)"/>
<g class="node model">
  <rect x="391" y="310" width="158" height="66" rx="10"/>
  <text class="title small" x="470" y="339">Names, addresses</text>
  <text class="mono" x="470" y="360">entities</text>
</g>
<path class="edge" d="M640 284 L640 301" marker-end="url(#arrow)"/>
<g class="node solid">
  <rect x="561" y="310" width="158" height="66" rx="10"/>
  <text class="title small" x="640" y="339">House rules</text>
  <text class="mono" x="640" y="360">policy</text>
</g>
<path class="edge" d="M810 284 L810 301" marker-end="url(#arrow)"/>
<g class="node solid">
  <rect x="731" y="310" width="158" height="66" rx="10"/>
  <text class="title small" x="810" y="339">Attacks</text>
  <text class="mono" x="810" y="360">injection</text>
</g>
<path class="edge" d="M980 284 L980 301" marker-end="url(#arrow)"/>
<g class="node solid">
  <rect x="901" y="310" width="158" height="66" rx="10"/>
  <text class="title small" x="980" y="339">Off-topic</text>
  <text class="mono" x="980" y="360">scope</text>
</g>
<path class="edge" d="M1150 284 L1150 301" marker-end="url(#arrow)"/>
<g class="node model">
  <rect x="1071" y="310" width="158" height="66" rx="10"/>
  <text class="title small" x="1150" y="339">Harmful content</text>
  <text class="mono" x="1150" y="360">content</text>
</g>
<path class="edge" d="M130 376 L130 400"/>
<path class="edge" d="M1150 376 L1150 400"/>
<path class="edge" d="M300 376 L300 400"/>
<path class="edge" d="M470 376 L470 400"/>
<path class="edge" d="M640 376 L640 400"/>
<path class="edge" d="M810 376 L810 400"/>
<path class="edge" d="M980 376 L980 400"/>
<path class="edge" d="M130 400 L1150 400"/>
<path class="edge" d="M640 400 L640 435" marker-end="url(#arrow)"/>
<text class="edge-label" x="654" y="426">seven opinions, one decision</text>
<g class="node gate" data-node="gate2">
  <rect x="340" y="444" width="600" height="84" rx="11"/>
  <text class="gate-label" x="360" y="470">GATE 2 — THE DECISION</text>
  <text class="title left" x="360" y="495">The strictest answer wins</text>
  <text class="mono left" x="360" y="517">block beats mask beats flag beats pass</text>
</g>
<path class="deny" d="M940 486 L1268 486"/>
<text class="deny-label" x="956" y="476">REFUSED — written down, then explained</text>
<path class="edge" d="M640 528 L640 563" marker-end="url(#arrow)"/>
<text class="edge-label" x="654" y="554">unless it was a close call</text>
<g class="node model" data-node="adjudicate">
  <rect x="340" y="572" width="600" height="80" rx="11"/>
  <text class="title" x="640" y="602">Was it too close to call?</text>
  <text class="mono" x="640" y="624">only when a score sits near its line — otherwise skipped</text>
</g>
<path class="edge" d="M640 652 L640 689" marker-end="url(#arrow)"/>
<text class="edge-label" x="654" y="679">personal details are now tokens</text>
<g class="node solid" data-node="retrieval">
  <rect x="340" y="698" width="600" height="96" rx="11"/>
  <text class="title" x="640" y="728">Look up the facts</text>
  <text class="mono" x="640" y="750">search the documents, and check what comes back</text>
  <text class="mono" x="640" y="768">the office's own address stays readable; yours does not</text>
</g>
<path class="edge" d="M640 794 L640 831" marker-end="url(#arrow)"/>
<text class="edge-label" x="654" y="821">the question, plus what was found</text>
<g class="node model" data-node="generate">
  <rect x="340" y="840" width="600" height="80" rx="11"/>
  <text class="title" x="640" y="870">Ask the model</text>
  <text class="mono" x="640" y="892">it only sees the tokens, and only the facts found above</text>
</g>
<path class="deny" d="M940 880 L1268 880"/>
<text class="deny-label" x="956" y="870">MODEL DECLINED</text>
<path class="edge" d="M640 920 L640 955" marker-end="url(#arrow)"/>
<text class="edge-label" x="654" y="946">a draft nobody has seen yet</text>
<g class="node gate" data-node="gate3">
  <rect x="340" y="964" width="600" height="84" rx="11"/>
  <text class="gate-label" x="360" y="990">GATE 3 — THE ANSWER</text>
  <text class="title left" x="360" y="1015">Is the answer allowed out?</text>
  <text class="mono left" x="360" y="1037">the same checks again, on the way back</text>
</g>
<path class="deny" d="M940 1006 L1268 1006"/>
<text class="deny-label" x="956" y="996">REFUSED — the draft is never shown</text>
<path class="edge" d="M640 1048 L640 1079" marker-end="url(#arrow)"/>
<g class="node gate" data-node="gate4">
  <rect x="340" y="1088" width="600" height="84" rx="11"/>
  <text class="gate-label" x="360" y="1114">GATE 4 — IS IT TRUE</text>
  <text class="title left" x="360" y="1139">Does it match the sources?</text>
  <text class="mono left" x="360" y="1161">every claim checked against what was found</text>
</g>
<path class="deny" d="M940 1130 L1268 1130"/>
<text class="deny-label" x="956" y="1120">SENT TO A PERSON</text>
<path class="edge" d="M640 1172 L640 1207" marker-end="url(#arrow)"/>
<g class="node data" data-node="audit">
  <rect x="290" y="1216" width="700" height="84" rx="11"/>
  <text class="title" x="640" y="1246">Put the real values back, and write it all down</text>
  <text class="mono" x="640" y="1268">the reader gets their own data; the log cannot be edited</text>
</g>
<path class="edge" d="M640 1300 L640 1335" marker-end="url(#arrow)"/>
<g class="node terminal" data-node="user-out">
  <rect x="405" y="1344" width="470" height="74" rx="11"/>
  <text class="title" x="640" y="1374">The answer, and the trace behind it</text>
  <text class="mono" x="640" y="1396">every check, its verdict, and how long it took</text>
</g>
<path class="deny" d="M1268 220 L1268 1258 L1000 1258" marker-end="url(#arrow-deny)"/>
<path class="loop" d="M340 1130 L208 1130 L208 880 L330 880" marker-end="url(#arrow-loop)"/>
<text class="loop-label" x="220" y="964">regenerate ≤ 2×</text>
<g class="node solid">
  <rect x="70" y="627" width="200" height="58" rx="10"/>
  <text class="title small" x="170" y="652">A document arrives</text>
  <text class="mono" x="170" y="670">uploaded, pasted, or scanned</text>
</g>
<path class="edge" d="M170 685 L170 706" marker-end="url(#arrow)"/>
<g class="node gate">
  <rect x="45" y="715" width="250" height="62" rx="10"/>
  <text class="gate-label" x="63" y="738">GATE — A DOCUMENT</text>
  <text class="mono left" x="63" y="760">checked before it is stored</text>
</g>
<path class="deny" d="M170 777 L170 801"/>
<text class="deny-label mid" x="170" y="817">quarantined — no search finds it</text>
<path class="edge" d="M295 746 L331 746" marker-end="url(#arrow)"/>
</svg>